# EMA Voice ayarları / settings. Komut satırından da verilebilir / can be set inline: DEVICE=cpu ./scripts/6_app.sh
DEVICE=${DEVICE:-cuda}          # cuda | cpu (cuda yoksa cpu kullanılır / falls back to cpu without cuda)
MODEL=${MODEL:-models/ema-voice.pt}
VOICES=${VOICES:-voices}        # eklenen sesler / added voices
